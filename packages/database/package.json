    "drizzle-orm": "^0.45.4",
    "server-only": "^0.0.1",
    "undici": "^7.22.0",
    "ws": "^8.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@podyard/typescript-config": "workspace:*",
    "@types/node": "25.3.5",
    "@types/ws": "^8.18.1",
    "bufferutil": "^4.1.0",
    "dotenv": "^16.5.0",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "exports": {
    ".": "./src/index.ts",

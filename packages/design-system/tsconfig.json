{
  "extends": "@podyard/typescript-config/nextjs.json",
  "compilerOptions": {
    "baseUrl": ".",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@podyard/observability/*": ["../observability/src/*"],
      "@podyard/*": ["../*"],
      "@podyard/design-system/*": ["./src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules"]
}

{
  "name": "podyard",
  "version": "0.1.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gabrielvfonseca/podyard.git"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.3.10",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "e2e",
    "tests",
    "tools"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "test": "turbo test",
    "analyze": "turbo analyze",
    "typecheck": "turbo typecheck",
    "clean": "turbo clean && git clean -xdf node_modules",
    "bump-deps": "bunx npm-check-updates --deep -u && bun install",
    "migrate": "cd packages/database && bunx drizzle-kit generate && bunx drizzle-kit migrate",
    "migrate:deploy": "cd packages/database && bunx drizzle-kit migrate",
    "db:generate": "cd packages/database && bunx drizzle-kit generate",
    "db:push": "cd packages/database && bunx drizzle-kit push",
    "prepare": "husky",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.6",
    "@changesets/cli": "^2.29.7",
    "@podyard/typescript-config": "workspace:*",
    "@turbo/gen": "^2.8.14",
    "@types/node": "^25.3.5",
    "husky": "^9.1.7",
    "turbo": "^2.8.14",
    "typescript": "^5.9.3",
    "ultracite": "7.2.5",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "parse5": "^7.2.1"
  }
}

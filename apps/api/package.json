{
  "name": "api",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm:hono-dev\" \"npm:stripe\"",
    "hono-dev": "bun --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "start": "bun dist/index.js",
    "test": "NODE_ENV=test vitest run",
    "stripe": "stripe listen --forward-to localhost:3002/webhooks/payments",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.22",
    "@hono/node-server": "^1.14.0",
    "@podyard/analytics": "workspace:*",
    "@podyard/auth": "workspace:*",
    "@podyard/database": "workspace:*",
    "@podyard/observability": "workspace:*",
    "@podyard/payments": "workspace:*",
    "@t3-oss/env-core": "^0.13.11",
    "@t3-oss/env-nextjs": "^0.13.10",
    "better-auth": "^1.3.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.6.0",
    "stripe": "^17.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@podyard/typescript-config": "workspace:*",
    "@types/node": "25.3.5",
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}

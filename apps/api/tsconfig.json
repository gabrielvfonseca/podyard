{
  "extends": "@podyard/typescript-config/base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@podyard/auth/*": ["../../packages/auth/src/*"],
      "@podyard/analytics/*": ["../../packages/analytics/src/*"],
      "@podyard/observability/*": ["../../packages/observability/src/*"],
      "@podyard/*": ["../../packages/*"]
    },
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ESNext",
    "lib": ["ESNext"],
    "jsx": "react-jsx"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "*.ts"],
  "exclude": ["node_modules", "dist"]
}
